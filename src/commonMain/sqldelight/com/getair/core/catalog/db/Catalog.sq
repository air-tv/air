CREATE TABLE catalog_source (
  source_id TEXT NOT NULL PRIMARY KEY,
  active_generation INTEGER,
  next_generation INTEGER NOT NULL DEFAULT 1,
  revision INTEGER NOT NULL DEFAULT 0,
  activated_at_ms INTEGER,
  deleted INTEGER NOT NULL DEFAULT 0 CHECK (deleted IN (0, 1))
);

CREATE TABLE catalog_generation (
  source_id TEXT NOT NULL,
  generation INTEGER NOT NULL,
  staged_at_ms INTEGER NOT NULL,
  PRIMARY KEY (source_id, generation)
);

CREATE TABLE catalog_entry (
  source_id TEXT NOT NULL,
  generation INTEGER NOT NULL,
  kind TEXT NOT NULL,
  catalog_id TEXT NOT NULL,
  entity_id TEXT NOT NULL,
  sort_order INTEGER NOT NULL,
  display_name TEXT NOT NULL,
  payload_version INTEGER NOT NULL,
  payload TEXT NOT NULL,
  PRIMARY KEY (source_id, generation, kind, catalog_id, entity_id)
);

CREATE UNIQUE INDEX catalog_entry_order
ON catalog_entry(source_id, generation, kind, catalog_id, sort_order, entity_id);

CREATE TABLE epg_channel (
  source_id TEXT NOT NULL,
  generation INTEGER NOT NULL,
  channel_id TEXT NOT NULL,
  sort_order INTEGER NOT NULL,
  display_name TEXT NOT NULL,
  payload_version INTEGER NOT NULL,
  payload TEXT NOT NULL,
  PRIMARY KEY (source_id, generation, channel_id)
);

CREATE UNIQUE INDEX epg_channel_order
ON epg_channel(source_id, generation, sort_order, channel_id);

CREATE TABLE epg_programme (
  source_id TEXT NOT NULL,
  generation INTEGER NOT NULL,
  channel_id TEXT NOT NULL,
  start_ms INTEGER NOT NULL,
  end_ms INTEGER NOT NULL,
  event_id TEXT NOT NULL,
  payload_version INTEGER NOT NULL,
  payload TEXT NOT NULL,
  PRIMARY KEY (source_id, generation, channel_id, start_ms, event_id),
  CHECK (end_ms > start_ms)
);

CREATE INDEX epg_programme_end
ON epg_programme(source_id, generation, channel_id, end_ms, start_ms);

CREATE TABLE guide_source_state (
  source_key TEXT NOT NULL PRIMARY KEY,
  mutation_epoch INTEGER NOT NULL DEFAULT 0 CHECK (mutation_epoch >= 0),
  delete_epoch INTEGER NOT NULL DEFAULT 0 CHECK (delete_epoch >= 0),
  active_feed_count INTEGER NOT NULL DEFAULT 0 CHECK (active_feed_count >= 0),
  staged_only_feed_count INTEGER NOT NULL DEFAULT 0 CHECK (staged_only_feed_count >= 0),
  deleted INTEGER NOT NULL DEFAULT 0 CHECK (deleted IN (0, 1))
);

CREATE TABLE guide_state (
  source_key TEXT NOT NULL,
  feed_id TEXT NOT NULL,
  active_generation INTEGER,
  latest_generation INTEGER,
  next_generation INTEGER NOT NULL DEFAULT 1 CHECK (next_generation > 0),
  revision INTEGER NOT NULL DEFAULT 0 CHECK (revision >= 0),
  mutation_epoch INTEGER NOT NULL DEFAULT 0 CHECK (mutation_epoch >= 0),
  source_epoch INTEGER NOT NULL DEFAULT 0 CHECK (source_epoch >= 0),
  deleted INTEGER NOT NULL DEFAULT 1 CHECK (deleted IN (0, 1)),
  PRIMARY KEY (source_key, feed_id)
);

CREATE INDEX guide_state_source_active
ON guide_state(source_key, source_epoch, deleted, feed_id);

CREATE INDEX guide_state_source_feed_epoch
ON guide_state(source_key, feed_id, source_epoch);

CREATE TABLE guide_generation (
  source_key TEXT NOT NULL,
  feed_id TEXT NOT NULL,
  generation INTEGER NOT NULL,
  status TEXT NOT NULL CHECK (
    status IN ('staging', 'published', 'abandoned', 'superseded', 'failed')
  ),
  writer_epoch INTEGER NOT NULL CHECK (writer_epoch > 0),
  created_at_ms INTEGER NOT NULL,
  expires_at_ms INTEGER NOT NULL,
  retention_anchor_ms INTEGER NOT NULL,
  retained_from_ms INTEGER NOT NULL,
  retained_until_ms INTEGER NOT NULL,
  attempted_batches INTEGER NOT NULL DEFAULT 0 CHECK (attempted_batches >= 0),
  attempted_channel_rows INTEGER NOT NULL DEFAULT 0 CHECK (attempted_channel_rows >= 0),
  attempted_programme_rows INTEGER NOT NULL DEFAULT 0 CHECK (attempted_programme_rows >= 0),
  channel_count INTEGER NOT NULL DEFAULT 0 CHECK (channel_count >= 0),
  programme_count INTEGER NOT NULL DEFAULT 0 CHECK (programme_count >= 0),
  next_programme_ordinal INTEGER NOT NULL DEFAULT 0 CHECK (next_programme_ordinal >= 0),
  cleanup_started INTEGER NOT NULL DEFAULT 0 CHECK (cleanup_started IN (0, 1)),
  PRIMARY KEY (source_key, feed_id, generation),
  CHECK (retained_from_ms < retained_until_ms)
);

CREATE INDEX guide_generation_expiry
ON guide_generation(status, expires_at_ms, source_key, feed_id, generation);

CREATE TABLE guide_channel (
  source_key TEXT NOT NULL,
  feed_id TEXT NOT NULL,
  generation INTEGER NOT NULL,
  channel_key TEXT NOT NULL,
  winner_key TEXT NOT NULL,
  display_names TEXT NOT NULL,
  artwork_reference TEXT,
  PRIMARY KEY (source_key, feed_id, generation, channel_key)
);

CREATE TABLE guide_programme (
  source_key TEXT NOT NULL,
  feed_id TEXT NOT NULL,
  generation INTEGER NOT NULL,
  ordinal INTEGER NOT NULL,
  channel_key TEXT NOT NULL,
  winner_key TEXT NOT NULL,
  start_ms INTEGER NOT NULL,
  end_ms INTEGER,
  effective_end_ms INTEGER NOT NULL,
  title TEXT NOT NULL,
  subtitle TEXT,
  description TEXT,
  categories TEXT NOT NULL,
  episode TEXT,
  artwork_reference TEXT,
  PRIMARY KEY (source_key, feed_id, generation, channel_key, start_ms),
  CHECK (effective_end_ms > start_ms),
  CHECK (end_ms IS NULL OR end_ms = effective_end_ms)
);

CREATE UNIQUE INDEX guide_programme_locator
ON guide_programme(source_key, feed_id, generation, ordinal);

CREATE INDEX guide_programme_timeline
ON guide_programme(source_key, feed_id, generation, channel_key, start_ms, ordinal);

CREATE INDEX guide_programme_overlap
ON guide_programme(
  source_key, feed_id, generation, channel_key, effective_end_ms, start_ms, ordinal
);

CREATE TABLE guide_lease (
  lease_id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  owner_id TEXT NOT NULL,
  source_key TEXT NOT NULL,
  feed_id TEXT NOT NULL,
  generation INTEGER NOT NULL,
  revision INTEGER NOT NULL,
  expires_at_ms INTEGER NOT NULL
);

CREATE INDEX guide_lease_owner_expiry
ON guide_lease(owner_id, expires_at_ms, lease_id);

CREATE INDEX guide_lease_expiry
ON guide_lease(expires_at_ms, lease_id);

CREATE INDEX guide_lease_generation_expiry
ON guide_lease(source_key, feed_id, generation, expires_at_ms);

CREATE TABLE guide_cleanup_queue (
  source_key TEXT NOT NULL,
  feed_id TEXT NOT NULL,
  generation INTEGER NOT NULL,
  enqueued_at_ms INTEGER NOT NULL,
  PRIMARY KEY (source_key, feed_id, generation)
);

CREATE INDEX guide_cleanup_order
ON guide_cleanup_queue(enqueued_at_ms, source_key, feed_id, generation);

CREATE TABLE guide_source_cleanup (
  source_key TEXT NOT NULL PRIMARY KEY,
  delete_epoch INTEGER NOT NULL CHECK (delete_epoch > 0),
  after_feed_id TEXT NOT NULL DEFAULT '',
  enqueued_at_ms INTEGER NOT NULL
);

CREATE INDEX guide_source_cleanup_order
ON guide_source_cleanup(enqueued_at_ms, source_key);

ensureSource:
INSERT OR IGNORE INTO catalog_source(source_id) VALUES (?);

prepareSourceRefresh:
UPDATE catalog_source SET deleted = 0 WHERE source_id = ?;

sourceState:
SELECT active_generation, next_generation, revision, activated_at_ms, deleted
FROM catalog_source
WHERE source_id = ?;

advanceGeneration:
UPDATE catalog_source
SET next_generation = next_generation + 1
WHERE source_id = ? AND next_generation = ?;

insertGeneration:
INSERT INTO catalog_generation(source_id, generation, staged_at_ms)
VALUES (?, ?, ?);

generationExists:
SELECT EXISTS(
  SELECT 1 FROM catalog_generation
  WHERE source_id = ? AND generation = ?
);

nextCatalogOrder:
SELECT COALESCE(MAX(sort_order) + 1, 0)
FROM catalog_entry
WHERE source_id = ? AND generation = ? AND kind = ? AND catalog_id = ?;

insertCatalogEntry:
INSERT OR REPLACE INTO catalog_entry(
  source_id, generation, kind, catalog_id, entity_id, sort_order,
  display_name, payload_version, payload
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

nextChannelOrder:
SELECT COALESCE(MAX(sort_order) + 1, 0)
FROM epg_channel
WHERE source_id = ? AND generation = ?;

insertEpgChannel:
INSERT OR REPLACE INTO epg_channel(
  source_id, generation, channel_id, sort_order, display_name,
  payload_version, payload
) VALUES (?, ?, ?, ?, ?, ?, ?);

insertEpgProgramme:
INSERT OR REPLACE INTO epg_programme(
  source_id, generation, channel_id, start_ms, end_ms, event_id,
  payload_version, payload
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

generationCatalogCount:
SELECT COUNT(*) FROM catalog_entry WHERE source_id = ? AND generation = ?;

generationChannelCount:
SELECT COUNT(*) FROM epg_channel WHERE source_id = ? AND generation = ?;

generationProgrammeCount:
SELECT COUNT(*) FROM epg_programme WHERE source_id = ? AND generation = ?;

activateGeneration:
UPDATE catalog_source
SET active_generation = ?,
    revision = revision + 1,
    activated_at_ms = ?,
    deleted = 0
WHERE source_id = ?;

catalogPage:
SELECT c.kind, c.catalog_id, c.entity_id, c.sort_order,
       c.payload_version, c.payload
FROM catalog_entry AS c
JOIN catalog_source AS s
  ON s.source_id = c.source_id AND s.active_generation = c.generation
WHERE c.source_id = ? AND s.deleted = 0
  AND c.kind = ? AND c.catalog_id = ? AND c.sort_order > ?
ORDER BY c.sort_order, c.entity_id
LIMIT ?;

channelPage:
SELECT c.channel_id, c.sort_order, c.payload_version, c.payload
FROM epg_channel AS c
JOIN catalog_source AS s
  ON s.source_id = c.source_id AND s.active_generation = c.generation
WHERE c.source_id = ? AND s.deleted = 0 AND c.sort_order > ?
ORDER BY c.sort_order, c.channel_id
LIMIT ?;

guideWindow:
SELECT p.event_id, p.payload_version, p.payload
FROM epg_programme AS p
JOIN catalog_source AS s
  ON s.source_id = p.source_id AND s.active_generation = p.generation
WHERE p.source_id = ? AND s.deleted = 0 AND p.channel_id = ?
  AND p.start_ms < ? AND p.end_ms > ?
ORDER BY p.start_ms, p.event_id
LIMIT ?;

currentProgramme:
SELECT p.event_id, p.payload_version, p.payload
FROM epg_programme AS p
JOIN catalog_source AS s
  ON s.source_id = p.source_id AND s.active_generation = p.generation
WHERE p.source_id = ? AND s.deleted = 0 AND p.channel_id = ?
  AND p.start_ms <= ? AND p.end_ms > ?
ORDER BY p.start_ms DESC, p.event_id
LIMIT 1;

nextProgramme:
SELECT p.event_id, p.payload_version, p.payload
FROM epg_programme AS p
JOIN catalog_source AS s
  ON s.source_id = p.source_id AND s.active_generation = p.generation
WHERE p.source_id = ? AND s.deleted = 0 AND p.channel_id = ?
  AND p.start_ms > ?
ORDER BY p.start_ms, p.event_id
LIMIT 1;

markSourceDeleted:
UPDATE catalog_source
SET active_generation = NULL, revision = revision + 1, deleted = 1
WHERE source_id = ? AND deleted = 0;

orphanGenerations:
SELECT g.source_id, g.generation
FROM catalog_generation AS g
LEFT JOIN catalog_source AS s ON s.source_id = g.source_id
WHERE s.source_id IS NULL OR s.active_generation IS NULL
   OR s.active_generation != g.generation OR s.deleted = 1
ORDER BY g.staged_at_ms, g.source_id, g.generation
LIMIT ?;

deleteCatalogChunk:
DELETE FROM catalog_entry
WHERE rowid IN (
  SELECT rowid FROM catalog_entry
  WHERE source_id = ? AND generation = ?
  LIMIT ?
);

deleteChannelChunk:
DELETE FROM epg_channel
WHERE rowid IN (
  SELECT rowid FROM epg_channel
  WHERE source_id = ? AND generation = ?
  LIMIT ?
);

deleteProgrammeChunk:
DELETE FROM epg_programme
WHERE rowid IN (
  SELECT rowid FROM epg_programme
  WHERE source_id = ? AND generation = ?
  LIMIT ?
);

generationRowCount:
SELECT
  (SELECT COUNT(*) FROM catalog_entry WHERE source_id = ? AND generation = ?) +
  (SELECT COUNT(*) FROM epg_channel WHERE source_id = ? AND generation = ?) +
  (SELECT COUNT(*) FROM epg_programme WHERE source_id = ? AND generation = ?);

deleteEmptyGeneration:
DELETE FROM catalog_generation
WHERE source_id = ? AND generation = ?
  AND NOT EXISTS (
    SELECT 1 FROM catalog_entry WHERE source_id = ? AND generation = ?
  )
  AND NOT EXISTS (
    SELECT 1 FROM epg_channel WHERE source_id = ? AND generation = ?
  )
  AND NOT EXISTS (
    SELECT 1 FROM epg_programme WHERE source_id = ? AND generation = ?
  );

deleteEmptySource:
DELETE FROM catalog_source
WHERE source_id = ? AND deleted = 1
  AND NOT EXISTS (
    SELECT 1 FROM catalog_generation WHERE source_id = ?
  );
